# ─── پایه ─────────────────────────────────────────
NODE_ENV=development
SITE_URL=https://miniroyal.shop
SITE_NAME="مینی رویال"
TZ=Asia/Tehran

# Hostinger Git is the primary deploy path. Only enable this if you intentionally
# want the application endpoint to run a second deployment process.
AUTO_DEPLOY_WEBHOOK=false
GITHUB_WEBHOOK_SECRET=
DEPLOY_STATUS_TOKEN=
ALLOWED_BRANCHES=main
ENFORCE_GITHUB_IP=false
DEPLOY_REPO_PATH=
RESTART_COMMAND=pm2 restart miniroyal

# ─── دیتابیس (MySQL / MariaDB) ─────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=miniroyal
# After creating the database on Hostinger, run database/schema.sql once.
# Never commit real credentials; enter them in Hostinger environment settings.

# ─── درگاه زرین‌پال ────────────────────────────────
ZARINPAL_MERCHANT_ID=your-active-merchant-id
ZARINPAL_SANDBOX=false       # پرداخت واقعی زرین‌پال
ZARINPAL_CALLBACK_URL=/payment/verify
PAYMENT_STATE_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_SECRET=replace-with-a-different-long-random-secret

# ─── AI (AgentRouter / OpenAI-compatible) ─────────
OPENAI_BASE_URL=https://api.agentrouter.org/v1
OPENAI_API_KEY=
OPENAI_MODEL=claude-opus-4-6
AI_MODEL_CHEAP=
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_VISION_MODEL=openrouter/free
DAHL_API_KEY=
DAHL_API_URL=https://inference.dahl.global/v1/chat/completions
DAHL_VISION_MODEL=
AGENTROUTER_API_KEY=
AGENTROUTER_API_URL=https://agentrouter.org/v1/chat/completions
AGENTROUTER_VISION_MODEL=
POLLINATIONS_API_KEY=

# ─── پیامک (OTP ورود مشتری) ───────────────────────
# سرویس‌های پشتیبانی‌شده در app/lib/sms.ts:
#   iranpayamak (= farazsms، همان api.iranpayamak.com) | kavenegar | smsir | console
# اگر SMS_PROVIDER خالی یا console باشد، پیامکی ارسال نمی‌شود؛ برای اینکه کد OTP
# در حالت console فقط در لاگ چاپ شود باید صریحاً SMS_CONSOLE_FALLBACK=true بگذارید.
SMS_PROVIDER=iranpayamak
SMS_API_KEY=
# شماره خط اختصاصی پنل (برای ایران‌پیامک اجباری است)
SMS_LINE_NUMBER=
# کد پترن/الگوی OTP در پنل ایران‌پیامک؛ متن الگو باید شامل %var1% باشد
SMS_PATTERN_CODE=
# فقط SMS.ir: شناسهٔ قالب «ارسال سریع» برای OTP (پارامتر CODE). بدون آن از خط اختصاصی استفاده می‌شود.
SMSIR_TEMPLATE_ID=
# فعال‌سازی چاپ کد OTP در لاگ به‌جای ارسال پیامک (فقط توسعه/دیباگ)
SMS_CONSOLE_FALLBACK=false
TRYON_FREE_LIMIT=5
TRYON_LIMIT_WINDOW_DAYS=30
TRYON_ADMIN_PHONES=
# مسیر دلخواه پنل مدیریت (مثلاً myshoppanel). خالی یعنی همان /admin.
ADMIN_PANEL_PATH=
# اگر ADMIN_PANEL_PATH را تنظیم کردید، همان مقدار را اینجا هم بگذارید تا هدر/فوتر
# فروشگاه و ویجت چت روی صفحه‌های پنل نمایش داده نشود.
NEXT_PUBLIC_ADMIN_PANEL_PATH=

# ─── زیرساخت (کلید مهاجرت cPanel ↔ VPS) ───────────
INFRA_STAGE=1          # 1=cPanel | 2=hybrid | 3=vps
QUEUE_DRIVER=mysql     # mysql | redis
STORAGE_DRIVER=fs      # fs | s3
SEARCH_DRIVER=mysql    # mysql | meili
VIDEO_DRIVER=browser   # browser | cloud | ffmpeg
POLLINATIONS_API_KEY=
AIHUBMIX_API_KEY=
AIHUBMIX_IMAGE_URL=https://aihubmix.com/v1/images/edits
AIHUBMIX_IMAGE_MODEL=gpt-image-2-free
AIHUBMIX_IMAGE_MODELS=gemini-3.1-flash-image-preview-free,gpt-image-2-free
AIHUBMIX_TRYON_URL=https://aihubmix.com/v1/models/doubao/doubao-seedream-4-5/predictions
AIHUBMIX_TRYON_MODEL=doubao-seedream-4-5
TRYON_USE_VISION_PROMPT=false
AIHUBMIX_IMAGE_SIZE=1024x1024
AIHUBMIX_IMAGE_QUALITY=auto
AIHUBMIX_TIMEOUT_MS=120000
TRYON_API_URL=https://gen.pollinations.ai/v1/images/edits
TRYON_MODEL=seedream
TRYON_TIMEOUT_MS=120000
NEXT_PUBLIC_WHATSAPP_NUMBER=989121234567

# ─── ارسال پستکس ───────────────────────────────────
# API key را فقط در Secrets هاست وارد کنید؛ هرگز در GitHub یا کد مرورگر قرار ندهید.
POSTEX_API_KEY=
POSTEX_BASE_URL=https://api.postex.ir
POSTEX_ORIGIN_CITY=اصفهان
POSTEX_ORIGIN_CITY_CODE=
POSTEX_ORIGIN_POSTAL_CODE=
POSTEX_ORIGIN_ADDRESS=
POSTEX_ORIGIN_MOBILE=
POSTEX_COLLECTION_TYPE=pick_up
POSTEX_COD_ENABLED=false
POSTEX_COD_CITIES=اصفهان
POSTEX_COURIER_CODE=
POSTEX_SERVICE_TYPE=EXPRESS
POSTEX_DEFAULT_BOX_TYPE_ID=0
POSTEX_DEFAULT_LENGTH_CM=30
POSTEX_DEFAULT_WIDTH_CM=20
POSTEX_DEFAULT_HEIGHT_CM=10
# مسیر و زمان‌بندی درخواست‌ها به پستکس (پیش‌فرض‌ها مطابق کلاینت رسمی پستکس)
POSTEX_API_PREFIX=/api/v1
POSTEX_GET_TIMEOUT_MS=15000
POSTEX_POST_TIMEOUT_MS=45000
# مدت کش فهرست شهرها در حافظهٔ سرور (پیش‌فرض ۶ ساعت)
POSTEX_CITIES_CACHE_MS=21600000

# ─── نرخ محلی روش‌های ارسال (تومان) ───────────
# فقط برای روش‌های غیرپستکس استفاده می‌شود؛ پستکس قیمت را آنلاین برمی‌گرداند.
NEXT_PUBLIC_SHIPPING_TARIFF_TIPAX=65000
NEXT_PUBLIC_SHIPPING_TARIFF_POST=45000
NEXT_PUBLIC_SHIPPING_TARIFF_PEYK=90000
