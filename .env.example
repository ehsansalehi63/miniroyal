# ─── پایه ─────────────────────────────────────────
NODE_ENV=development
SITE_URL=https://miniroyal.ir
SITE_NAME="مینی رویال"
TZ=Asia/Tehran

# Hostinger Git is the primary deploy path. Only enable this if you intentionally
# want the application endpoint to run a second deployment process.
AUTO_DEPLOY_WEBHOOK=false
GITHUB_WEBHOOK_SECRET=

# ─── دیتابیس (MySQL / MariaDB) ─────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=miniroyal

# ─── درگاه زرین‌پال ────────────────────────────────
ZARINPAL_MERCHANT_ID=your-active-merchant-id
ZARINPAL_SANDBOX=false       # پرداخت واقعی زرین‌پال
ZARINPAL_CALLBACK_URL=/payment/verify
PAYMENT_STATE_SECRET=replace-with-a-long-random-secret

# ─── AI (AgentRouter / OpenAI-compatible) ─────────
OPENAI_BASE_URL=https://api.agentrouter.org/v1
OPENAI_API_KEY=
OPENAI_MODEL=claude-opus-4-6
AI_MODEL_CHEAP=
POLLINATIONS_API_KEY=

# ─── پیامک (اختیاری — بدون کلید، کد OTP در لاگ) ────
SMS_PROVIDER=console   # console | kavenegar | smsir
SMS_API_KEY=

# ─── زیرساخت (کلید مهاجرت cPanel ↔ VPS) ───────────
INFRA_STAGE=1          # 1=cPanel | 2=hybrid | 3=vps
QUEUE_DRIVER=mysql     # mysql | redis
STORAGE_DRIVER=fs      # fs | s3
SEARCH_DRIVER=mysql    # mysql | meili
VIDEO_DRIVER=browser   # browser | cloud | ffmpeg
POLLINATIONS_API_KEY=
TRYON_API_URL=https://gen.pollinations.ai/v1/images/edits
TRYON_MODEL=kontext
