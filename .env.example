# ─── پایه ─────────────────────────────────────────
NODE_ENV=development
SITE_URL=https://miniroyal.shop
SITE_NAME="مینی رویال"
TZ=Asia/Tehran

# Hostinger Git is the primary deploy path. Only enable this if you intentionally
# want the application endpoint to run a second deployment process.
AUTO_DEPLOY_WEBHOOK=false
GITHUB_WEBHOOK_SECRET=
DEPLOY_STATUS_TOKEN=
ALLOWED_BRANCHES=main
ENFORCE_GITHUB_IP=false
DEPLOY_REPO_PATH=
RESTART_COMMAND=pm2 restart miniroyal

# ─── دیتابیس (MySQL / MariaDB) ─────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=miniroyal
# After creating the database on Hostinger, run database/schema.sql once.
# Never commit real credentials; enter them in Hostinger environment settings.

# ─── درگاه زرین‌پال ────────────────────────────────
ZARINPAL_MERCHANT_ID=your-active-merchant-id
ZARINPAL_SANDBOX=false       # پرداخت واقعی زرین‌پال
ZARINPAL_CALLBACK_URL=/payment/verify
PAYMENT_STATE_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_SECRET=replace-with-a-different-long-random-secret

# ─── AI (AgentRouter / OpenAI-compatible) ─────────
OPENAI_BASE_URL=https://api.agentrouter.org/v1
OPENAI_API_KEY=
OPENAI_MODEL=claude-opus-4-6
AI_MODEL_CHEAP=
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_VISION_MODEL=openrouter/free
DAHL_API_KEY=
DAHL_API_URL=https://inference.dahl.global/v1/chat/completions
DAHL_VISION_MODEL=
POLLINATIONS_API_KEY=

# ─── پیامک (اختیاری — بدون کلید، کد OTP در لاگ) ────
SMS_PROVIDER=console   # console | kavenegar | smsir
SMS_API_KEY=

# ─── زیرساخت (کلید مهاجرت cPanel ↔ VPS) ───────────
INFRA_STAGE=1          # 1=cPanel | 2=hybrid | 3=vps
QUEUE_DRIVER=mysql     # mysql | redis
STORAGE_DRIVER=fs      # fs | s3
SEARCH_DRIVER=mysql    # mysql | meili
VIDEO_DRIVER=browser   # browser | cloud | ffmpeg
POLLINATIONS_API_KEY=
AIHUBMIX_API_KEY=
AIHUBMIX_IMAGE_URL=https://aihubmix.com/v1/images/edits
AIHUBMIX_IMAGE_MODEL=gpt-image-2-free
AIHUBMIX_IMAGE_MODELS=gemini-3.1-flash-image-preview-free,gpt-image-2-free
AIHUBMIX_IMAGE_SIZE=1024x1024
AIHUBMIX_IMAGE_QUALITY=auto
AIHUBMIX_TIMEOUT_MS=120000
TRYON_API_URL=https://gen.pollinations.ai/v1/images/edits
TRYON_MODEL=seedream
TRYON_TIMEOUT_MS=120000
NEXT_PUBLIC_WHATSAPP_NUMBER=989121234567
